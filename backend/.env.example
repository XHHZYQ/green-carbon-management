# 数据库连接（本地 WSL Docker：postgres 映射端口 5433）
DATABASE_URL=postgresql+asyncpg://green_carbon:green_carbon@localhost:5433/green_carbon

# 数据库连接（同步，仅脚本/调试用）
DATABASE_URL_SYNC=postgresql+psycopg2://green_carbon:green_carbon@localhost:5433/green_carbon

# JWT 配置
JWT_SECRET_KEY=green-carbon-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# 应用配置
APP_NAME=绿色低碳智慧管控系统
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
